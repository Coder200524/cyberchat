# ============================================================
# CyberChat Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to GitHub!
# ============================================================

# --- Server ---
PORT=5000
CLIENT_URL=http://localhost:5173

# --- MongoDB Atlas ---
# How to get this:
# 1. Go to https://cloud.mongodb.com
# 2. Create a free cluster
# 3. Click "Connect" → "Connect your application"
# 4. Copy the connection string and replace <password> and <dbname>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/cyberchat?retryWrites=true&w=majority

# --- JWT Secret ---
# Use any long random string (e.g. generate one at https://randomkeygen.com/)
JWT_SECRET=your_super_secret_jwt_key_here

# --- Cloudinary (for file/image uploads) ---
# How to get these:
# 1. Go to https://cloudinary.com and create a free account
# 2. Go to your Dashboard
# 3. Copy Cloud Name, API Key, and API Secret from the top panel
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
